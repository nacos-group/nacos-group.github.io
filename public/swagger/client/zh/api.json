会创建空 Client，也不会续约 Publisher 活性，因此不能替代 Publisher heartbeat。","required":false,"schema":{"type":"string"}},{"name":"namespaceId","in":"query","example":"public"},{"name":"agentName","in":"query","required":true,"example":"my-agent"},{"name":"version","in":"query","example":"1.0.0"},{"name":"label","in":"query","example":"latest"},{"name":"protocol","in":"query","schema":{"type":"array","items":{"type":"string"}}},{"name":"protocolVersion","in":"query","example":1.0},{"name":"transport","in":"query","schema":{"type":"array","items":{"type":"string"}}},{"name":"endpointSource","in":"query","schema":{"type":"array","items":{"type":"string"}}},{"name":"metadataSelector","in":"query","description":"Metadata selector JSON object"}],"responses":{"200":{"description":"OK","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Result<AgentDiscoveryResult>","example":{"code":0,"message":"success","data":{"namespaceId":"public","agentName":"my-agent","version":"1.0.0","callInterfaces":[]}}}}}}},"security":[{"nacos":[]}],"x-nacos-api-since":{"version":"3.3.0"}},"post":{"tags":["Nacos AI Agent 客户端 API"],"summary":"发布 Agent 定义","description":"从应用代码发布指定 Agent 版本，并可选择自动提交评审。","operationId":"publish","parameters":[{"name":"namespaceId","in":"query","example":"public"},{"name":"agentName","in":"query","required":true,"example":"my-agent"},{"name":"version","in":"query","required":true,"example":"1.0.0"},{"name":"displayName","in":"query","example":"My Agent"},{"name":"description","in":"query","example":"Agent description"},{"name":"iconUrl","in":"query","example":"https://example.com/agent.png"},{"name":"provider","in":"query","description":"Agent provider JSON object"},{"name":"tags","in":"query","description":"Agent tag JSON array"},{"name":"extensions","in":"query","description":"Agent extension JSON object"},{"name":"callInterfaces","in":"query","description":"Call interface JSON array"},{"name":"author","in":"query","example":"nacos"},{"name":"changeDescription","in":"query","example":"Initial version"},{"name":"basedOnVersion","in":"query","example":"0.9.0"},{"name":"autoSubmit","in":"query","schema":{"type":"boolean"},"example":false}],"responses":{"200":{"description":"OK","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Result<AgentVersionDetail>","example":{"code":0,"message":"success","data":{"namespaceId":"public","agentName":"my-agent","version":"1.0.0","status":"draft","callInterfaces":[]}}}}}}},"security":[{"nacos":[]}],"x-nacos-api-since":{"version":"3.3.0"}}},"/v3/client/ai/agents/endpoints":{"post":{"tags":["Nacos AI Agent 客户端 API"],"summary":"注册 Agent 端点","description":"替换某个 HTTP Publisher 针对 Agent 协议发布的完整运行时 Endpoint Batch。同一逻辑客户端在其绑定 namespace 下拥有的全部 Batch 必须复用一个稳定的 X-Nacos-Client-Id。返回的 ClientLivenessInfo 是服务端实际活性策略：应按 heartbeatIntervalMillis 为该 client id 调度一个心跳任务，而不是为每个 Endpoint 或 Batch 分别调度。","operationId":"registerEndpoints","parameters":[{"name":"X-Nacos-Client-Id","in":"header","description":"逻辑 HTTP Client 必填的稳定 opaque 标识。每个客户端或 SDK 实例生成一个唯一值，建议至少包含 96 bit 随机熵；UUID 是合法值，且长度必须为 1～256、匹配 [A-Za-z0-9._:-]+。Endpoint 注册、注销、心跳、重试、Server 切换和 redo 必须复用该值，客户端实例或进程重启后生成新值；互不相关的客户端或进程不得共享同一 id。首次 Endpoint 写入会将该 id 绑定到鉴权主体和 namespace。该 id 归属客户端的全部 Endpoint Publication，是路由标识而非 credential。","required":true,"schema":{"type":"string"}},{"name":"Request-Module","in":"header","description":"Endpoint Publisher 生命周期操作的必填 Header，请将 Request-Module 设置为 AI。","required":true,"schema":{"type":"string"}},{"name":"namespaceId","in":"query","example":"public"},{"name":"agentName","in":"query","required":true,"example":"my-agent"},{"name":"runtimeVersion","in":"query","required":true,"example":"1.0.0"},{"name":"versionRange","in":"query","example":"[1.0.0,2.0.0)"},{"name":"protocol","in":"query","required":true,"example":"a2a"},{"name":"endpoints","in":"query","description":"Endpoint JSON array","required":true}],"responses":{"200":{"description":"OK","content":{"application/json":{"schema":{"$ref":"#/components/